# =============================================================
# ClauseWise — Environment Variables Example
# Copy to .env.local for local development, or configure in
# Vercel Project Settings → Environment Variables for deployment.
# NEVER commit .env.local or any real secrets.
# =============================================================

# --- Database (REQUIRED for app start & database access) ---
# Supabase PostgreSQL connection string (with pgvector enabled).
# For Vercel serverless deployment, use the Supabase Transaction Pooler URL (port 6543):
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# For local development or running migrations (pnpm db:setup / pnpm db:migrate),
# either the Session Pooler / Direct URL (port 5432) or Transaction Pooler URL works.
DATABASE_URL=postgresql://user:password@localhost:5432/clausewise

# --- Authentication / NextAuth.js v5 (REQUIRED for authentication) ---
# Generate with: openssl rand -base64 32 (must be at least 32 characters)
NEXTAUTH_SECRET=replace-with-at-least-32-char-random-secret
# Full canonical URL of your deployment (no trailing slash).
# Example for Vercel: https://your-project.vercel.app
# Optional on Vercel when trustHost is enabled, but recommended for production.
NEXTAUTH_URL=http://localhost:3000

# --- Supabase Storage (REQUIRED for document uploads & extraction) ---
# Project URL from Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
# Service role key (server-side only — NEVER expose to browser or prefix with NEXT_PUBLIC_)
# Note: Ensure a private bucket named "documents" exists in Supabase Storage.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- OpenAI API (REQUIRED for live AI analysis, embeddings, and Q&A) ---
# Server-side only — NEVER prefix with NEXT_PUBLIC_.
# Optional at build/startup time, but required at runtime for document intelligence & Q&A.
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
# Optional tuning for serverless execution limits (defaults: 60000ms timeout, 2 retries)
# OPENAI_TIMEOUT_MS=25000
# OPENAI_MAX_RETRIES=1

# --- Optional / Local Development & Testing Only ---
# Public app URL (optional; used for Server Action origin allowlisting if set)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Client-side Supabase keys (optional; not currently used as all Storage access is server-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# E2E test harness toggle (keep unset or "false" in production)
# ENABLE_TEST_ROUTES=false


