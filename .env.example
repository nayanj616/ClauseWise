# =============================================================
# ClauseWise — Environment Variables Example
# Copy to .env.local and fill in real values.
# NEVER commit .env.local or any real secrets.
# =============================================================

# --- Database ---
# PostgreSQL connection string with pgvector extension enabled
DATABASE_URL=postgresql://user:password@localhost:5432/clausewise

# --- NextAuth.js ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-at-least-32-char-random-secret
# Full URL of your deployment (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# --- Supabase Storage ---
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
# Service role key (server-side only — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Anon/public key (safe to expose — used for client-side Storage URL construction only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- OpenAI ---
# Server-side only — never use NEXT_PUBLIC_ prefix
OPENAI_API_KEY=sk-replace-with-your-openai-api-key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

